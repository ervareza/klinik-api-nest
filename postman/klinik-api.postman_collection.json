        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('meta pagination', () => pm.expect(pm.response.json().meta.limit).to.eql(2));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients?gender=FEMALE&sortBy=fullName&sortOrder=asc&page=1&limit=2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients"
          ],
          "query": [
            {
              "key": "gender",
              "value": "FEMALE"
            },
            {
              "key": "sortBy",
              "value": "fullName"
            },
            {
              "key": "sortOrder",
              "value": "asc"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
